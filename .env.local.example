# =============================================================================
# AUCTION SERVICE - LOCAL ENVIRONMENT CONFIGURATION (.env.local.example)
# =============================================================================
# Áp dụng: cp .env.local.example .env
ASPNETCORE_ENVIRONMENT=Development
AUCTION_SERVICE_PORT=8005

# Database Connection (Local Docker PostgreSQL: Port 5437)
CONNECTION_STRING=Host=localhost;Port=5437;Database=auction_db;Username=postgres;Password=postgres
AUCTION_CONNECTION_STRING=Host=localhost;Port=5437;Database=auction_db;Username=postgres;Password=postgres
AUCTION_DB_PORT=5437
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
