# =============================================================================
# ENVIRONMENT VARIABLES FOR AUCTION SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
AUCTION_SERVICE_PORT=8005

# Database Connection (Neon Cloud PostgreSQL)
CONNECTION_STRING=Host=ep-summer-shape-b3m9hy77-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=auction_db;Username=neondb_owner;Password=<REPLACE_WITH_AUCTION_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
AUCTION_CONNECTION_STRING=Host=ep-summer-shape-b3m9hy77-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=auction_db;Username=neondb_owner;Password=<REPLACE_WITH_AUCTION_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
