# =============================================================================
# ENVIRONMENT VARIABLES FOR AUCTION SERVICE (.env.example)
# =============================================================================
# Hỗ trợ 2 hồ sơ môi trường:
#   1. Local DB (PostgreSQL Cục bộ port 5437): cp .env.local.example .env
#   2. Server DB (PostgreSQL Neon Cloud):      cp .env.server.example .env
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
AUCTION_SERVICE_PORT=8005

# Database Connection (Mặc định Local DB)
CONNECTION_STRING=Host=localhost;Port=5437;Database=auction_db;Username=postgres;Password=postgres
AUCTION_CONNECTION_STRING=Host=localhost;Port=5437;Database=auction_db;Username=postgres;Password=postgres
AUCTION_DB_PORT=5437
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
