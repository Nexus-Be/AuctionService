# Environment variables for Auction Service
ASPNETCORE_ENVIRONMENT=Development
AUCTION_SERVICE_PORT=8005
AUCTION_DB_PORT=5437

# Database Connection (Neon Cloud PostgreSQL)
CONNECTION_STRING=Host=ep-green-wave-a1b7qj0e.ap-southeast-1.aws.neon.tech;Port=5432;Database=auction_db;Username=neondb_owner;Password=<REPLACE_WITH_AUCTION_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Database (PostgreSQL Local Fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REPLACE_WITH_DB_PASSWORD>

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
