# =============================================================================
# ENVIRONMENT VARIABLES FOR AUCTION SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
AUCTION_SERVICE_PORT=8005

# Database Connection (Local PostgreSQL - Port 5437)
CONNECTION_STRING=Host=localhost;Port=5437;Database=auction_db;Username=postgres;Password=postgres
AUCTION_CONNECTION_STRING=Host=localhost;Port=5437;Database=auction_db;Username=postgres;Password=postgres
AUCTION_DB_PORT=5437
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ (Docker network: rabbitmq; Local host: localhost)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
